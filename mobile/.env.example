# Base URL of the API, including /api/v1. EXPO_PUBLIC_* values are bundled into the app and are
# public: never put secrets here.
# Simulator / emulator on this computer: http://localhost:5001/api/v1
# Physical phone (Expo Go or a dev build): use this computer's LAN IP, e.g.
#   http://192.168.1.20:5001/api/v1  (macOS: `ipconfig getifaddr en0`; phone on the same Wi-Fi)
EXPO_PUBLIC_API_URL=http://localhost:5001/api/v1
