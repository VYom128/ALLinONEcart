# Server environment. Copy to server/.env and adjust. Validated at startup by src/config/env.ts.
# Never commit server/.env. Variables are added here in the phase that first needs them (spec §3.6).

# --- Phase 0 ---------------------------------------------------------------

# development | test | production
NODE_ENV=development
# API port. 5001 because macOS AirPlay Receiver holds 5000.
PORT=5001
# MongoDB connection string; must be a replica set (transactions). Docker compose maps it to 27018.
MONGO_URI=mongodb://localhost:27018/allinone?replicaSet=rs0&directConnection=true
# Redis connection string (BullMQ, cache, rate limits).
REDIS_URL=redis://localhost:6379
# Comma-separated CORS allow-list (admin panel, later the web app). The mobile app sends no Origin.
CLIENT_URLS=http://localhost:5173
# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Global API rate limit: window in milliseconds (15 min) and max requests per IP per window.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Later phases (uncomment when the phase adds them) ---------------------

# Phase 1 – access token secret (at least 32 characters) and lifetime.
# JWT_ACCESS_SECRET=
# JWT_ACCESS_EXPIRES_IN=15m
# Phase 1 – refresh token lifetime in days.
# REFRESH_TOKEN_TTL_DAYS=30
# Phase 1 – OTP lifetime in seconds and max attempts.
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# Phase 1 – SMS transport: console (dev/test) | msg91 | twilio. Must not be console in production.
# SMS_TRANSPORT=console
# SMS_API_KEY=
# SMS_SENDER_ID=
# Phase 1 – lets +9100000000xx sign in with OTP 000000. Refused when NODE_ENV=production.
# ALLOW_TEST_OTP=true
# Phase 1 – ID-token audience checks for Google and Apple sign-in.
# GOOGLE_CLIENT_IDS=
# APPLE_BUNDLE_ID=
# Phase 1 – HMAC secret for the audit log hash chain.
# AUDIT_HASH_SECRET=

# Phase 2 – object storage: MinIO locally, Cloudflare R2 in production.
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=allinone-dev
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# PUBLIC_ASSET_URL=http://localhost:9000/allinone-dev
# Phase 2 – store fetching: per-request timeout, /extract budget (ms) and Playwright for JS-rendered stores.
# FETCH_TIMEOUT_MS=8000
# EXTRACT_BUDGET_MS=3000
# PLAYWRIGHT_ENABLED=true
# Phase 2 – dev/test only: base URL that replaces real store hosts.
# MOCKSTORES_URL=http://localhost:4010
# Phase 2 – the worker schedules repeatable jobs only when true.
# JOBS_ENABLED=true

# Phase 3 – max upload size in MB.
# MAX_UPLOAD_MB=10

# Phase 5 – 32-byte key (base64) that encrypts income and contribution amounts.
# ENCRYPTION_KEY=
# Phase 5 – Expo push access token.
# EXPO_ACCESS_TOKEN=

# Phase 6 – Sentry DSN (server + worker) and PostHog key.
# SENTRY_DSN=
# POSTHOG_KEY=

# Phase 7 – comparison sources.
# AMAZON_PAAPI_*=
# FLIPKART_AFFILIATE_*=

# Phase 9 – affiliate networks.
# AFFILIATE_*=
