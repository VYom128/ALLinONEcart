# Optional overrides for docker-compose.yml. Copy to .env only if you need to change them.

# Host port for MongoDB (27018 so a Homebrew MongoDB on 27017 can keep running).
MONGO_PORT=27018
# Host port for Redis.
REDIS_PORT=6379
# Host ports for the MinIO S3 API and web console.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# MinIO root credentials (local development only).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
